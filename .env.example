# Copy to .env and adjust. Never commit real secrets.

# --- docker compose ---
POSTGRES_DB=schooltrack
POSTGRES_USER=schooltrack
POSTGRES_PASSWORD=schooltrack_owner_dev
SCHOOLTRACK_APP_DB_PASSWORD=schooltrack_app_dev
POSTGRES_PORT=5432
API_PORT=8000

# --- backend, when running outside Docker (from backend/) ---
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://schooltrack_app:schooltrack_app_dev@localhost:5432/schooltrack
MIGRATIONS_DATABASE_URL=postgresql+psycopg://schooltrack:schooltrack_owner_dev@localhost:5432/schooltrack
CORS_ORIGINS=["http://localhost:3000"]

# Geolocation thresholds (experimental defaults)
GEOFENCE_DEFAULT_RADIUS_M=100
GPS_MAX_ACCURACY_M=30
LOCATION_MAX_AGE_S=30
REQUEST_MAX_AGE_S=15
