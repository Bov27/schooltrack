# Copy to .env and adjust. Never commit real secrets.

# --- docker compose ---
POSTGRES_DB=schooltrack
POSTGRES_USER=schooltrack
POSTGRES_PASSWORD=schooltrack_owner_dev
SCHOOLTRACK_APP_DB_PASSWORD=schooltrack_app_dev
SCHOOLTRACK_PLATFORM_DB_PASSWORD=schooltrack_platform_dev
SCHOOLTRACK_WORKER_DB_PASSWORD=schooltrack_worker_dev
POSTGRES_PORT=5432
API_PORT=8000

# --- backend, when running outside Docker (from backend/) ---
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://schooltrack_app:schooltrack_app_dev@localhost:5432/schooltrack
MIGRATIONS_DATABASE_URL=postgresql+psycopg://schooltrack:schooltrack_owner_dev@localhost:5432/schooltrack
PLATFORM_DATABASE_URL=postgresql+psycopg://schooltrack_platform:schooltrack_platform_dev@localhost:5432/schooltrack
WORKER_DATABASE_URL=postgresql+psycopg://schooltrack_worker:schooltrack_worker_dev@localhost:5432/schooltrack
REDIS_URL=redis://localhost:6379/0
PUSH_PROVIDER=log
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=["http://localhost:3000"]

# Geolocation thresholds (experimental defaults)
GEOFENCE_DEFAULT_RADIUS_M=100
GPS_MAX_ACCURACY_M=30
LOCATION_MAX_AGE_S=30
REQUEST_MAX_AGE_S=15
